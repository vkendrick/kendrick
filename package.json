{
  "name": "kendrick",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run copy-functions && npm run copy-proposta && npm run generate-sitemap && npm run inject-analytics",
    "copy-functions": "xcopy /E /I /Y functions dist\\functions 2>nul || cp -r functions dist/functions",
    "copy-proposta": "node scripts/copy-proposta.mjs",
    "generate-sitemap": "node scripts/generate-sitemap.mjs",
    "inject-analytics": "node scripts/inject-analytics.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist",
    "pages:deploy": "wrangler pages deploy dist --project-name=kendrick-consultoria"
  },
  "dependencies": {
    "@hono/vite-dev-server": "^0.26.0",
    "@hono/zod-validator": "^0.8.0",
    "@tailwindcss/vite": "^4.3.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "hono": "^4.12.25",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "wrangler": "^4.99.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260610.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
